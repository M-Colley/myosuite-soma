+def _motion_velocities(clip: Any, model: Any) -> Any:
+    """Validate replay samples and obtain quaternion-aware joint velocities."""
+    import mujoco
+    import numpy as np
+
+    if (
+        clip.frequency_hz is None
+        or not math.isfinite(clip.frequency_hz)
+        or clip.frequency_hz <= 0
+    ):
+        raise ValueError("Motion clip frequency must be finite and positive.")
+    if len(clip.qpos) < 2 or not np.isfinite(clip.qpos).all():
+        raise ValueError("Motion clip requires at least two finite position samples.")
+    if clip.qvel is not None:
+        velocity = np.asarray(clip.qvel)
+        if (
+            velocity.shape != (len(clip.qpos), model.nv)
+            or not np.isfinite(velocity).all()
+        ):
+            raise ValueError(
+                "Motion clip velocities must match its frames and model DOFs."
+            )
+        return velocity
+    velocity = np.empty((len(clip.qpos), model.nv), dtype=np.float64)
+    for frame in range(len(clip.qpos)):
+        before, after = max(0, frame - 1), min(len(clip.qpos) - 1, frame + 1)
+        mujoco.mj_differentiatePos(
+            model,
+            velocity[frame],
+            (after - before) / clip.frequency_hz,
+            clip.qpos[before],
+            clip.qpos[after],
+        )
+    return velocity
+
