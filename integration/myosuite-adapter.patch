+def _activation_tracks(output: Path, meta: dict[str, Any]) -> list[tuple[str, Any]]:
+    """Read visual activation separately from the recorded simulation channels."""
+    import numpy as np
+
+    path = output / "muscles.npz"
+    if meta.get("muscle_color", "activation") != "activation" or not path.exists():
+        return []
+    with np.load(path) as recorded:
+        columns = meta.get("muscle_activation_columns")
+        if columns is None:
+            columns = {name: m for m, name in enumerate(meta["muscle_objects"])}
+            activation = recorded["activation"]
+        else:
+            activation = recorded["visual_activation"]
+        if any(not 0 <= column < activation.shape[1] for column in columns.values()):
+            raise ValueError(
+                "Muscle colour mapping references a missing activation column."
+            )
+        return [(name, activation[:, column]) for name, column in columns.items()]
+
+
+def _initial_muscle_colour(name: str, meta: dict[str, Any]) -> tuple[float, ...]:
+    """Unmapped anatomy has a uniform colour, without an invented activation."""
+    mapped = any(key in name for key in meta.get("muscle_activation_columns", {}))
+    if meta.get("muscle_color") == "uniform" or (meta.get("soma") and not mapped):
+        return MUSCLE_UNIFORM
+    return _muscle_colour(0.0, meta.get("muscles") == "paths" and not meta.get("soma"))
+
